# build.sh がビルドする FFmpeg のソース。build.sh、package_release.sh、ワークフローが読みます。
#
# FFmpeg の版を上げるとき:
#   1. https://ffmpeg.org/releases/ から ffmpeg-<版>.tar.xz と ffmpeg-<版>.tar.xz.asc を取ってくる
#   2. gpg --import ffmpeg-devel.asc のあと gpg --verify ffmpeg-<版>.tar.xz.asc ffmpeg-<版>.tar.xz
#      （Primary key fingerprint が下の FFMPEG_SIGNING_KEY と同じこと）
#   3. sha256sum ffmpeg-<版>.tar.xz の値で FFMPEG_VERSION と FFMPEG_SHA256 を書き換える
#   4. PITATRACK_BUILD を 1 に戻す。版はそのままで configure-options.txt だけ変えたときは 1 つ上げる
#
# 9.0.2 "Lei"（2026-09-18）: 2026-10-18 に下の鍵で署名を確かめた。

FFMPEG_VERSION=9.0.2
FFMPEG_SHA256=8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e
FFMPEG_SIGNING_KEY=FCF986EA15E6E293A5644F10B4322F04D67658D8

# ffmpeg -version に "9.0.2-pitatrack3" と出る。GitHub Release のタグ ffmpeg-9.0.2-pitatrack3 にも使う。
# 2: ボーカル分離に使う部品（wav と ipod のマルチプレクサー、amerge、pan、alimiter）を足した（2026-10-19）
# 3: MP4 の中の AC-3 / E-AC-3 を自動調整とボーカル分離の対象にするデコーダー（ac3、eac3）を足した（2026-10-19）
PITATRACK_BUILD=3
